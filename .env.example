# Admin-Rechte: kommagetrennte Liste von E-Mail-Adressen, die beim Login
# automatisch isAdmin erhalten (siehe isAdminEmail() in server/routes/userAuth.ts)
ADMIN_EMAILS=admin@example.com

# Session Secret für Express-Sessions
SESSION_SECRET=IhrSicheresSessionSecret

# Brevo (E-Mail-Versand)
BREVO_API_KEY=your-brevo-api-key
SMTP_FROM=your-email@example.com

# Backup-Job (GitHub Actions o.ä.) - Shared Secret fuer GET /api/backup/full
BACKUP_API_KEY=IhrZufaelligerBackupSchluessel

# Railway.app setzt diese automatisch:
# RAILWAY_ENVIRONMENT, RAILWAY_PUBLIC_DOMAIN, PORT
